{
  "name": "arxiv2zh",
  "type": "module",
  "version": "0.1.2",
  "description": "Translate arXiv papers with hjfy.top and attach Chinese PDFs in Zotero.",
  "private": true,
  "keywords": [
    "zotero",
    "zotero-plugin",
    "arxiv",
    "pdf",
    "translation"
  ],
  "config": {
    "addonName": "arxiv2zh",
    "addonID": "arxiv2zh@kongyan66",
    "addonRef": "arxiv2zh",
    "addonInstance": "Arxiv2zh",
    "prefsPrefix": "extensions.zotero.arxiv2zh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongyan66/arxiv2zh.git"
  },
  "author": "kongyan66",
  "bugs": {
    "url": "https://github.com/kongyan66/arxiv2zh/issues"
  },
  "homepage": "https://github.com/kongyan66/arxiv2zh#readme",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "check": "npm run lint:check && npm run typecheck && npm run test",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "npm run test:unit",
    "test:integration": "zotero-plugin test --no-watch",
    "test:unit": "node --experimental-strip-types --test test/unit/*.test.mts",
    "typecheck": "tsc --noEmit",
    "update-deps": "npm update --save"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
